---
// The landing page. THIS FILE IS THE WORLD'S OWN — the tooling sync never overwrites it, and
// neither does the worldkit: this is the one page that is pure prose, and prose is not chrome.
// Replace the REPLACE_ME copy with the world's own. The structure, the tokens and the components
// are the theme's; keep them or change them, it is a world's file.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FollowForm from '../components/FollowForm.astro';
import {
  SITE,
  contentDescriptors,
  doorways,
  formatDate,
  sections,
  whatToExpect,
  codexUpdated,
} from '../lib/site';

const pages = await getCollection('pages');
const sectionCounts = new Map(sections.map((s) => [s.slug, s.count]));

// Hero art: drop a file into site/public/img/ named after `site.hero_file` in world.config.yaml and
// it is used. Until then the hero is just its own background — no invented artwork. The art brief
// is site/image-prompts/.
const HERO_FILES = ['avif', 'webp', 'jpg', 'png', 'svg'].map((ext) => `${SITE.heroFile}.${ext}`);
const heroImage = HERO_FILES.find((f) => existsSync(join(process.cwd(), 'public', 'img', f)));
---

<BaseLayout>
  <!-- The hero. One image lands later; until then the section is honest about being a placeholder. -->
  <section class="hero flex min-h-[70vh] max-h-[680px] items-end md:max-h-none">
    {
      heroImage && (
        <>
          <img
            class="hero-image"
            src={`/img/${heroImage}`}
            alt={SITE.heroAlt}
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-shade" aria-hidden="true" />
        </>
      )
    }

    <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-24 pt-28 sm:px-8 sm:pb-32">
      <p class="eyebrow text-sand/80">A world for tabletop roleplaying</p>
      <h1 class="wordmark mt-5 text-[clamp(2.6rem,9vw,6.5rem)] text-bone">{SITE.name}</h1>
      <p class="mt-6 max-w-2xl font-display text-[clamp(1.3rem,2.6vw,1.7rem)] leading-snug text-parchment/90">
        {SITE.tagline}
      </p>
      {heroImage && SITE.heroCredit && (
        <p class="mt-6 text-[0.7rem] uppercase tracking-[0.16em] text-sand/50">{SITE.heroCredit}</p>
      )}
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href="/codex/"
          class="border border-ember bg-ember px-6 py-3 text-[0.8rem] uppercase tracking-[0.16em] text-bone no-underline transition-colors hover:border-bone hover:bg-transparent hover:text-bone"
        >
          Enter the codex
        </a>

        <a href="#the-world" class="scroll-cue text-sand/80 no-underline hover:text-bone"
          >Read the world ↓</a
        >
      </div>
    </div>
  </section>

  <!-- 1. The world, in three paragraphs. THE WORLD'S OWN COPY: replace all of it. -->
  <section id="the-world" class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-x-14 gap-y-8 md:grid-cols-[minmax(0,42rem)_13rem]">
      <div>
        <p class="eyebrow">The world</p>
        <h2 class="mt-3 text-[clamp(1.9rem,4vw,2.6rem)]">REPLACE_ME — a heading in the world's voice</h2>
        <div class="prose-hollow mt-6 max-w-[62ch] text-[1.1rem]">
          <p>
            REPLACE_ME — the premise, in two or three sentences a stranger can follow. What the world
            is, what went wrong, and what that means for the people in it now.
          </p>
          <p>
            REPLACE_ME — what is scarce, and what that does to ordinary life. This is the paragraph
            that tells a reader what a game here is *about*.
          </p>
          <p>
            REPLACE_ME — what is permanently broken, and what a party can still change. No clean
            fixes; but not nothing.
          </p>
        </div>
      </div>
      <aside class="marginalia border-l border-[var(--rule)] pl-5 md:border-l-0 md:border-t md:pl-0 md:pt-5">
        <p>
          REPLACE_ME — one line of the world's own voice, a saying or a warning a resident would
          repeat.
        </p>
        <p class="mt-4">
          <!-- Link into a section the world actually publishes, e.g. /history/<slug>/ -->
          <a href="/codex/" class="no-underline">Start with the history →</a>
        </p>
      </aside>
    </div>
  </section>

  <!-- 2. What this is. Mostly generic: it describes a codex site, not the world. -->
  <section class="border-y border-[var(--rule)] bg-parchment/45">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:gap-16">
        <div>
          <p class="eyebrow">What this is</p>
          <h2 class="mt-3 text-[clamp(1.7rem,3.4vw,2.2rem)]">A world bible, written in the open</h2>
          <p class="mt-5 max-w-[46ch] text-[1.05rem] text-ash">
            {SITE.name} is a world being built for tabletop campaigns. This site is its player-facing
            codex: the history, the powers, the places and the things that are wrong with all of them.
          </p>
          <p class="mt-4 max-w-[46ch] text-[1.05rem] text-ash">
            It is a living draft. Entries change as the world is worked out, and each revision is
            recorded. Built to run in the Mythical Forge game engine.
          </p>
        </div>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 self-start">
          <div>
            <dt class="eyebrow">Entries</dt>
            <dd class="font-display text-[2rem] leading-none">{pages.length}</dd>
          </div>
          <div>
            <dt class="eyebrow">Sections</dt>
            <dd class="font-display text-[2rem] leading-none">{sectionCounts.size}</dd>
          </div>
          <div>
            <dt class="eyebrow">Last rebuilt</dt>
            <dd class="mt-1 text-[0.95rem] text-ash">{formatDate(codexUpdated)}</dd>
          </div>
          <div>
            <dt class="eyebrow">Spoilers</dt>
            <dd class="mt-1 text-[0.95rem] text-ash">None. Residents' knowledge only.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 3. Doorways. Config-driven: the entries come from `site.doorways` in world.config.yaml. -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24" aria-labelledby="doorways">
    <h2 id="doorways" class="text-[clamp(1.7rem,3.4vw,2.2rem)]">Ways in</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        doorways.map((d) => (
          <li>
            <a href={d.href} class="entry-card group block h-full p-6 no-underline">
              <h3 class="text-[1.35rem] group-hover:text-ember">{d.label}</h3>
              <p class="mt-2 max-w-[38ch] text-[0.97rem] text-ash/90">{d.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 4. What to expect. Config-driven: `principles/what-to-expect.md` supplies the lines. -->
  <section class="border-y border-[var(--rule)] bg-parchment/45" aria-labelledby="expect">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <p class="eyebrow">At the table</p>
      <h2 id="expect" class="mt-3 text-[clamp(1.7rem,3.4vw,2.2rem)]">What to expect</h2>
      <ul class="mt-8 grid gap-x-12 gap-y-5 md:grid-cols-2">
        {
          whatToExpect.map((line) => (
            <li class="border-l-2 border-ember/70 pl-4 text-[1.02rem] text-ash">{line}</li>
          ))
        }
      </ul>
      <p class="marginalia mt-8">
        {SITE.name} campaigns use the content descriptors
        <span class="not-italic tracking-wide text-ash">
          {contentDescriptors.join(', ')}
        </span>
        unless a campaign says otherwise.
      </p>
    </div>
  </section>

  <!-- 5. The spoilers promise. Generic, and worth keeping: it is what makes the site safe to read. -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8" aria-labelledby="spoilers">
    <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:gap-16">
      <div>
        <p class="eyebrow">The promise</p>
        <h2 id="spoilers" class="mt-3 text-[clamp(1.7rem,3.4vw,2.2rem)]">
          Only what a resident would know
        </h2>
        <p class="mt-5 max-w-[46ch] text-[1.05rem] text-ash">
          Everything here is drawn from the parts of the codex that ordinary people in {SITE.name}
          could know, believe or repeat. The secrets — and if this world is built the way it should
          be, there are layered ones — are not on this site.
        </p>
        <p class="mt-4 max-w-[46ch] text-[1.05rem] text-ash">
          Where the world disagrees with itself, you will see the disagreement: the official line,
          the popular myth, and what a rival power says instead.
        </p>
      </div>
      <div class="no-spoilers self-start">
        <p class="font-display text-[1.25rem] leading-snug">
          “REPLACE_ME — a line a resident would say, in quotation marks.”
        </p>
        <p class="mt-3 text-[0.95rem]">
          REPLACE_ME — where it comes from, in one sentence, using only what a resident could know.
        </p>
        <p class="mt-3 text-[0.95rem]">
          <a href="/codex/" class="no-underline">REPLACE_ME — a link into the codex →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Follow along. Generic. -->
  <section class="border-t border-[var(--rule)]" aria-labelledby="follow">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:gap-16">
        <div>
          <p class="eyebrow">Follow along</p>
          <h2 id="follow" class="mt-3 text-[clamp(1.7rem,3.4vw,2.2rem)]">
            The world is still being written
          </h2>
          <p class="mt-4 max-w-[44ch] text-[1.02rem] text-ash">
            New entries and revisions land as the codex grows. There is a
            <a href="/changelog/">changelog</a> if you would rather check in yourself.
          </p>
        </div>
        <div class="self-center">
          <FollowForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
